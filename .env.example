# Copy to .env and fill from your Entra ID app registrations.
# .env is gitignored (NFR-5) — never commit real values.

# Directory (tenant) ID — Entra ID > Overview
TENANT_ID=00000000-0000-0000-0000-000000000000

# SPA app registration (public client, PKCE, no secret) — its Application (client) ID
SPA_CLIENT_ID=00000000-0000-0000-0000-000000000000

# API app registration — its Application (client) ID. Becomes the expected `aud`.
API_CLIENT_ID=00000000-0000-0000-0000-000000000000

# The scope the SPA requests, from the API's "Expose an API" blade.
# Format: api://<API_CLIENT_ID>/<scope-name>
API_SCOPE=api://00000000-0000-0000-0000-000000000000/Api.Access

# App role required by GET /api/admin. Must match the role's *value* exactly.
REQUIRED_ROLE=Resource.Admin

# Must match the redirect URI registered on the SPA app registration, exactly.
SPA_REDIRECT_URI=http://localhost:3000
API_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Host ports. Only change these if 3000/8080 are already in use on your machine.
# If you change SPA_HOST_PORT you MUST also update SPA_REDIRECT_URI,
# CORS_ALLOWED_ORIGINS, and the redirect URI on the Entra ID app registration —
# Entra ID matches the redirect URI exactly, including the port.
SPA_HOST_PORT=3000
API_HOST_PORT=8080
